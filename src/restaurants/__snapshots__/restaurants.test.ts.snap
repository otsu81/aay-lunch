exports[`restaurant fixtures > parses MiaMarias 1`] = `
{
  "menu": {
    "fri": "Ugnsbakad fisk med chorizosmör, citronrostad potatis och bakade tomater.<br>Schnitzelfredag! Koreansk pankopanerad kycklingschnitzel med gochujangmajonnäs, pickladgurka, sesamrostad spetskål och ris.<br>Aubergine parmigiana med mozzarella, tomatsås, basilika och Grana Padano. Serverasmed ruccolasallad och vitlöksbröd.",
    "mon": "Ugnsbakad sej med vitvinssås, citron, dill, gröna ärtor och kokt potatis.<br>Fransk kycklinggryta med dijonsenap, dragon, champinjoner och vitt vin. Serveras med ris.<br>Rostad blomkål med kryddig kikärtsragu, örtig bulgur, granatäpple och citronyoghurt",
    "thu": "Ugnsbakad fisk med ört- och citrontäcke, kall romsås, kokt potatis och gröna ärtor.<br>Småländska isterband med dillstuvad potatis, inlagda rödbetor och grovkornig senap.<br>Filorulle fylld med fetaost, zucchini och örter. Serveras med tomatsallad och tzatziki.<br>Ärtsoppa med eller utan fläsk samt pannkaksbuffé.",
    "tue": "Ugnsbakad kolja med brynt smör, kapris, citron, kokt potatis och rostade morötter<br>Wallenbergare med potatismos, skirat smör, gröna ärtor och rårörda lingon.<br>Spaghetti med ädelostsås, rostad zucchini, smörstekta päron, mandel och tranbär.",
    "wed": "Citron- och örtbakad lax med rostade småtomater och oliver, serveras med rostad potatis ochbasilikayoghurt.<br>Baconlindad fläskfilé med portvinssås, potatisgratäng och smörstekta grönsaker.<br>Majsplättar med Västerbottensost, rostad paprikasalsa, avokadokräm och örtigbulgursallad.",
  },
  "periodConfirmed": true,
  "status": "available",
  "validFrom": "2026-11-23",
  "validUntil": "2026-11-27",
}
`;

exports[`restaurant fixtures > parses Niagara 1`] = `
