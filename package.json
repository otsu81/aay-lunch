{
  "name": "aay-scraper",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "deploy": "wrangler d1 migrations apply aay-lunch-prod --remote -e prod && wrangler deploy -e prod",
    "dev": "wrangler d1 migrations apply aay-lunch --local -e dev && wrangler dev -e dev",
    "test": "vitest run",
    "cf-typegen": "wrangler types -e dev",
    "lint": "biome check && tsc --noEmit",
    "lint:fix": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@cloudflare/vitest-plugin": "^1.8.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "hono": "^4.13.18",
    "linkedom": "^0.18.15"
  }
}
